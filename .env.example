# Copy to .env for local live-voice use. Never commit a real key.
# Deepgram: speech-to-text (Nova) and text-to-speech (Aura).
# Leave blank for browser-fallback demo mode.
DEEPGRAM_API_KEY=
# Local demo uses SQLite. On AWS, set this to your RDS Postgres URL.
DATABASE_URL=sqlite:///./data/bookings.db
